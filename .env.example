# ============ PredictorLab ============

# --- Р”РµС„РѕР»С‚РЅС‹Р№ Р°РґРјРёРЅ (СЃРѕР·РґР°С‘С‚СЃСЏ РїСЂРё РїРµСЂРІРѕРј СЃС‚Р°СЂС‚Рµ; РїСЂРё РїРµСЂРІРѕРј РІС…РѕРґРµ С‚СЂРµР±СѓРµС‚СЃСЏ СЃРјРµРЅР° РїР°СЂРѕР»СЏ) ---
ADMIN_EMAIL=admin@predictorlab.io
ADMIN_PASSWORD=admin

# --- Р‘РµР·РѕРїР°СЃРЅРѕСЃС‚СЊ ---
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-too

# --- РҐСЂР°РЅРёР»РёС‰Р° (РІРЅСѓС‚СЂРё РєРѕРЅС‚РµР№РЅРµСЂР°; РјРѕР¶РЅРѕ РїРµСЂРµРѕРїСЂРµРґРµР»РёС‚СЊ volume) ---
STORAGE_DIR=storage
DATA_DIR=data

# --- Р›РёРјРёС‚С‹ РґР°РЅРЅС‹С… ---
MAX_ROWS=500000
MAX_COLUMNS=200

# --- РћР±СѓС‡РµРЅРёРµ ---
TRAIN_TIME_BUDGET_SEC=600
DETERMINISTIC=false
SEED=42
QUICK_ITERATIONS=500

# --- LLM (РїСѓСЃС‚РѕР№ LLM_BASE_URL = РѕС„Р»Р°Р№РЅ-СЂРµР¶РёРј, LLM-С„СѓРЅРєС†РёРё СЃРєСЂС‹С‚С‹) ---
LLM_BASE_URL=
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=
LLM_ALLOW_SAMPLES=false

# --- РљРѕРЅС‚СЂС„Р°РєС‚СѓР°Р»С‹ Рё РїР»РµР№Р±СѓРє ---
CF_TIMEOUT_SEC=10
PLAYBOOK_MAX_ROWS=1000

# --- РџСЂРѕРіРЅРѕР·С‹ ---
TOP_REASON_ROWS=1000
PREDICTION_LOG_TTL_DAYS=180
MAX_BATCH_ROWS=100000

# --- API-РєР»СЋС‡Рё / rate limit ---
GLOBAL_RATE_LIMIT_RPM=120
PUBLIC_RATE_LIMIT_RPM=30

# --- РџСѓР±Р»РёС‡РЅС‹Рµ СЃС‚СЂР°РЅРёС†С‹: Р±Р°Р·РѕРІС‹Р№ URL РґР»СЏ СЃРіРµРЅРµСЂРёСЂРѕРІР°РЅРЅС‹С… СЃСЃС‹Р»РѕРє ---
PUBLIC_BASE_URL=http://localhost:3000

# --- РџРѕРґРїРёСЃСЊ Р°СЂС‚РµС„Р°РєС‚РѕРІ (РїСѓСЃС‚Рѕ = РїРѕРґРїРёСЃСЊ РІС‹РєР»СЋС‡РµРЅР°, РёРјРїРѕСЂС‚ РјРѕРґРµР»РµР№ Р·Р°РїСЂРµС‰С‘РЅ) ---
ARTIFACT_SIGNING_KEY=

# --- TabPFN (v0.3, РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ; С‚СЂРµР±СѓРµС‚ pip install predictorlab[tabpfn]) ---
TABPFN_ENABLED=false

# --- РњРѕРЅРёС‚РѕСЂРёРЅРі ---
DRIFT_PSI_WARN=0.1
DRIFT_PSI_DRIFT=0.25
RETRAIN_CHECK_MINUTES=60

# --- MCP ---
MCP_AUTH_TOKEN=
MCP_ALLOW_TRAIN=false
